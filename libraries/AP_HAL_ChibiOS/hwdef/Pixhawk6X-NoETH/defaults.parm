# 仿真相关参数（HITL 必需）
AHRS_EKF_TYPE 10
GPS1_TYPE 100
BATT_MONITOR   0
SIM_RATE_HZ 400
SCHED_LOOP_RATE 400
SIM_MAG1_DEVID 97539
SIM_BARO_RND  0

# IMU 校准（仿真用，让 INS 认为已校准）
INS_ACCOFFS_X   0.001
INS_ACCOFFS_Y   0.001
INS_ACCOFFS_Z   0.001
INS_ACCSCAL_X   1.001
INS_ACCSCAL_Y   1.001
INS_ACCSCAL_Z   1.001
INS_ACC2OFFS_X   0.001
INS_ACC2OFFS_Y   0.001
INS_ACC2OFFS_Z   0.001
INS_ACC2SCAL_X   1.001
INS_ACC2SCAL_Y   1.001
INS_ACC2SCAL_Z   1.001

# 罗盘偏移（仿真）
COMPASS_OFS_X   5
COMPASS_OFS_Y   13
COMPASS_OFS_Z   -18
COMPASS_OFS2_X   5
COMPASS_OFS2_Y   13
COMPASS_OFS2_Z   -18

# 电机悬停参数
MOT_THST_EXPO   0.65
MOT_THST_HOVER  0.39
MOT_BAT_VOLT_MIN 9.6
MOT_BAT_VOLT_MAX 12.8

# 系统参数
FENCE_RADIUS   150
FS_THR_ENABLE  1
BRD_RTC_TYPES 2
BRD_OPTIONS 9
EK3_PRIMARY 1

# === QuadPlane 倾转旋翼参数（来自 quadplane-tilthvec.parm）===
Q_ENABLE         1
Q_FRAME_CLASS    1
Q_FRAME_TYPE     3
Q_TILT_TYPE      0
Q_TILT_YAW_ANGLE 10
Q_TILT_MASK      15
Q_RTL_MODE       1
Q_VFWD_GAIN      0.1
Q_ANGLE_MAX      4500
Q_ASSIST_SPEED   6
PTCH_LIM_MAX_DEG 30.00
PTCH_LIM_MIN_DEG -30.00

# 倾转舵机
SERVO12_FUNCTION 41
SERVO13_FUNCTION 41
SERVO12_MIN 1000
SERVO12_MAX 2000
SERVO13_MIN 1000
SERVO13_MAX 2000

# 速率PID
Q_A_RAT_RLL_P 0.15
Q_A_RAT_PIT_P 0.15
Q_A_RAT_RLL_D 0.002
Q_A_RAT_PIT_D 0.002
