# DF-200: inner 4 tilting (40in) + outer 4 fixed vertical (60in)
# Geometry/aero: docs/数据库_v2.xlsx ; power: docs/电机电池.docx (整机 350kg)
# SITL: SIM_Frame df200_motors + Tools/autotest/models/df200.json
# Mixer: Lua Motors_dynamic via Q_FRAME_CLASS=17 (scripts/df200_motor_matrix.lua)
# Roll differential fades with airspeed (AS 15→30 → scale 1.0→0.2).
# Docs: docs/vtol_df200.md
#
# IMPORTANT: use -f quadplane-df200 (json is bound in vehicleinfo.py model=).
#   ./Tools/autotest/sim_vehicle.py -v ArduPlane -f quadplane-df200 -w --no-mavproxy
# Do NOT append :path.json on -f or df200.parm will be dropped.
# NOTE: frame string must contain "-df200" and SIM_QuadPlane/SIM_Plane must
# match df200 (avoids jt20 prefix clash) (strstr("-jt20") would also hit "-df200").
#
# Restored from logs/00000086.BIN — Excel large-I hover-success set
# (mass≈380 kg flight, moment_inertia=[783.6,464.3,1052.3]).
# Do NOT use the small-I P=3/5 tier with this json.

# SITL: skip pre-arm so we don't have to clear checks every run
ARMING_CHECK     0

Q_ENABLE         1
Q_FRAME_CLASS    17
Q_FRAME_TYPE     0
Q_TILT_TYPE      0
Q_TILT_YAW_ANGLE 0
Q_TILT_MASK      15
Q_TILT_MAX       45
Q_ASSIST_SPEED   10
Q_ASSIST_ANGLE   60
# bit21 DISARMED_TILT_UP (2097152) + bit23 ALIGN_HDG_BEFORE_TRANS (8388608)
Q_OPTIONS        10485760
# 090: TF_YAW_ERR=25 + strong yaw let align finish and reach FW done
Q_TF_YAW_ERR     25
Q_TF_YAW_TMO     0
Q_RTL_MODE       3

Q_TRANSITION_MS 500000
Q_TILT_RATE_UP  10

# prop-table model: T ≈ actuator^2 (T∝RPM²), hover actuator ≈0.68,
# W/T_max = 3727/7656 ≈ 0.49 → expo=1.0 (pure sqrt inversion), hover thrust 0.49
Q_M_THST_HOVER   0.49
Q_M_HOVER_LEARN  2
Q_M_YAW_HEADROOM 400

Q_A_ANG_RLL_P    3.0
Q_A_ANG_PIT_P    4.0
Q_A_ANG_YAW_P    6.0

# Large-I hover tune (matched to Excel moment_inertia); PIT/RLL from 086
Q_A_RAT_PIT_P    8.0
Q_A_RAT_PIT_I    0.01
Q_A_RAT_PIT_D    0.05

Q_A_RAT_RLL_P    8.0
Q_A_RAT_RLL_I    0.01
Q_A_RAT_RLL_D    0.05

# 090 yaw boost (with json motor*_yaw=±3) — required to clear align + transition
Q_A_RAT_YAW_P    1.2
Q_A_RAT_YAW_I    0.12
Q_A_RAT_YAW_D    0.02

Q_A_RATE_P_MAX   45
Q_A_RATE_R_MAX   45
Q_A_RATE_Y_MAX   90
Q_A_ACCEL_P_MAX  30000
Q_A_ACCEL_R_MAX  30000
Q_A_ACCEL_Y_MAX  27000
Q_A_THR_MIX_MAX  0.5
Q_A_THR_MIX_MIN  0.1
Q_A_INPUT_TC     0.40
Q_ANGLE_MAX      2000
Q_PILOT_SPD_UP   1.0
Q_PILOT_ACCEL_Z  0.8
# 090 had these; without them -w falls back to stock 250/100 and
# AUTO takeoff saturates Mot on large-I DF-200 (see 093).
Q_WP_SPEED_UP    100
Q_WP_SPEED_DN     80
Q_WP_ACCEL_Z      50

# Transition / speeds (cruise ~48.6 m/s from 数据库)
AIRSPEED_CRUISE  55
AIRSPEED_MIN     45
AIRSPEED_MAX     80
ARSPD_USE        1

# Fixed-wing surface / TECS
# WAIT Elev/Ail ≈ FW rate_PID(PDes/RDes) × SS. Soften surfaces around AS≈27.
# SS ≈ SCALING_SPEED / airspeed (clamped); lower SCALING_SPEED → smaller SS.
SCALING_SPEED    45
PTCH_RATE_FF     0.35
RLL_RATE_FF      0.14
TECS_PITCH_MIN  -10
TECS_PITCH_MAX   15
PTCH_LIM_MIN_DEG -15
PTCH_LIM_MAX_DEG  15

KFF_RDDRMIX      0.5
RLL2SRV_TCONST   0.5
PTCH2SRV_TCONST  0.5
NAVL1_PERIOD     22
WP_RADIUS        400
NAVL1_DAMPING    0.75

ROLL_LIMIT_DEG   40


# Fixed-wing attitude control gains (restored after 163 found them all 0:
# yaw rate r=-54.7 constant, Yout=0, plane spun into ground. These are FW
# servo-loop gains, separate from SITL aero c_n_r/c_l_b coefficients.)
YAW2SRV_DAMP     2.0     # yaw rate -> rudder damping (was 0, r unchecked)
YAW2SRV_SLIP     1.0     # sideslip -> rudder correction (was 0)
YAW2SRV_RLL      1.0     # roll->rudder coordination
YAW2SRV_IMAX     1500    # rudder integrator max
RLL2SRV_RMAX     120–180      # roll rate limit deg/s (was 0, roll crippled)
PTCH2SRV_RMAX_UP 40      # pitch rate up limit (was 0, TECS pitch oscillated)
PTCH2SRV_RMAX_DN 40      # pitch rate down limit (was 0)
PTCH2SRV_RATE_P  1.0    # pitch rate P gain (default 1.0, raise for big plane)
PTCH2SRV_RATE_I  0.15    # pitch rate I gain (default, keep)
PTCH2SRV_RATE_D  0.06    # pitch rate D gain (default 0.08, raise for damping)
LIM_ROLL_CD      4500    # bank angle limit (45 deg)
LIM_PITCH_MAX    2000    # max pitch (20 deg)
LIM_PITCH_MIN    -2500   # min pitch (-25 deg)

# TECS longitudinal control (170: pitch oscillated ±3°, DesPitch swinging)
TECS_SPDWEIGHT   0.5     # balance speed/height (was 1.0=all-speed, caused oscillation)
TECS_TIME_CONST  5.0     # TECS response time (was 5.0, too slow for big plane)

# Scripting custom mixer
SCR_ENABLE       1

# Motors 1-8 on SERVO5-12 (motor_offset=4 in SIM_QuadPlane)
SERVO5_FUNCTION  33
SERVO6_FUNCTION  34
SERVO7_FUNCTION  35
SERVO8_FUNCTION  36
SERVO9_FUNCTION  37
SERVO10_FUNCTION 38
SERVO11_FUNCTION 39
SERVO12_FUNCTION 40

# Unified tilt (k_motor_tilt=41). APM: current_tilt=0 → vertical → scaled~0 → PWM≈MIN
# SITL Motor pitch_min/max = -90..+10 maps PWM MIN≈up, MAX≈forward.
SERVO13_FUNCTION 41
SERVO14_FUNCTION 41
SERVO13_MIN 1000
SERVO13_MAX 2000
SERVO14_MIN 1000
SERVO14_MAX 2000
SERVO13_REVERSED 0
SERVO14_REVERSED 0

# Battery: ~400 V class (电机电池.docx 表头 ~398 V)
BATT_MONITOR     4
BATT_CAPACITY    100000
Q_M_BAT_VOLT_MAX 420
Q_M_BAT_VOLT_MIN 360
# prop-table model is T∝actuator² → expo=1.0 makes thrust_to_actuator the
# exact sqrt inversion (175: 0.65 + hover 0.45 mismatch → rate-loop limit
# cycle, lim=1111, motors railing 0↔1, avg cmd ~0.5 < hover 0.68)
Q_M_THST_EXPO    1.0
Q_M_PWM_MIN      1000
Q_M_PWM_MAX      2000
