# DF-200 tiltrotor SITL model — Excel-faithful test build
# Geometry/I/CG: docs/数据库_v2.xlsx (旋翼位置垂起行, 基本信息)
# Power: xlsx 动力参数 + docs/电机电池.docx (外60桨峰值~1379N, 内40@3600RPM=540N)
# Layout: inner 4 tilting + outer 4 fixed vertical. Same motor order as JT-20 / Lua.
#
# Structure frame (S): nose origin, X aft, Y right, Z up.
# APM body: hover CG origin, X fwd, Y right, Z down.
#   X_apm = CGx - X_s;  Y_apm = Y_s;  Z_apm = CGz - Z_s
# Hover CG (structure): (1.900, 0, 0.483) m
#
# QuadPlane does mass *= 1.5 after Frame::init → flight mass = json_mass * 1.5.
# This build uses Excel MTOW 380 kg → json mass = 380/1.5.
# Hover inertia diagonal from Excel 垂起矩阵: Ixx=783.6, Iyy=464.3, Izz=1052.3
#
# Thrust: peak Σ ≈ 4*1379 + 4*540 = 7676 N → T/W@380 ≈ 2.06
# hoverThrOut=0.30 → T_max_model = mass_json*g/0.30 ≈ 8.28 kN → T/W_flight≈2.22

{
    "mass" : 253.333,

    "diagonal_size" : 5.93,

    "refSpd" : 48.6,
    "refAngle" : 45.0,
    "refVoltage" : 400.0,
    "refCurrent" : 200.0,
    "refAlt" : 0.0,
    "refTempC" : 25.0,
    "refBatRes" : 0.05,

    "maxVoltage" : 400.0,
    "battCapacityAh" : 0.0,

    "propExpo" : 0.65,
    "refRotRate" : 60.0,

    "hoverThrOut" : 0.30,

    "pwmMin" : 1000,
    "pwmMax" : 2000,
    "spin_min" : 0.15,
    "spin_max" : 0.95,
    "slew_max" : 150.0,

    "disc_area" : 10.54,

    "mdrag_coef" : 0.2,
    "num_motors" : 8,

    "moment_inertia" : [200.6, 464.3, 500.3],

    # Force/moment isolation trial:
    # - tilt motors Z coplanar at 0 (was front -0.409 / rear -0.944) to kill
    #   Tilt=30° equal-thrust My_geom ≈ z*Fx bias.
    # - motor*_yaw = ±0.5 (was ±3) to shrink rotor reaction Mz (~1/6).
    # Outer verts Z left at Excel -0.270 (Fx=0 when untilted; not the My term).
    # Expect DF200ROTOR pre-onset: |Mgeom_y| and |Mrotor_z| much smaller.
    # M1 FR tilt  ①
    "motor1_position"  : [1.720,  1.315, 0.0],
    "motor1_vector"    : [0.0, 0.0, -1.0],
    "motor1_yaw"       : 9,
    # M2 RL tilt  ⑥
    "motor2_position"  : [-1.720, -1.315, 0.0],
    "motor2_vector"    : [0.0, 0.0, -1.0],
    "motor2_yaw"       : 9,
    # M3 FL tilt  ⑤
    "motor3_position"  : [1.720, -1.315, 0.0],
    "motor3_vector"    : [0.0, 0.0, -1.0],
    "motor3_yaw"       : -9,
    # M4 RR tilt  ②
    "motor4_position"  : [-1.720,  1.315, 0.0],
    "motor4_vector"    : [0.0, 0.0, -1.0],
    "motor4_yaw"       : -9,
    # M5 FR vert  ③
    "motor5_position"  : [1.150,  2.732, 0.0],
    "motor5_vector"    : [0.0, 0.0, -1.0],
    "motor5_yaw"       : 9,
    # M6 RL vert  ⑧
    "motor6_position"  : [-1.150, -2.732, 0.0],
    "motor6_vector"    : [0.0, 0.0, -1.0],
    "motor6_yaw"       : 9,
    # M7 FL vert  ⑦
    "motor7_position"  : [1.150, -2.732, 0.0],
    "motor7_vector"    : [0.0, 0.0, -1.0],
    "motor7_yaw"       : -9,
    # M8 RR vert  ④
    "motor8_position"  : [-1.150,  2.732, 0.0],
    "motor8_vector"    : [0.0, 0.0, -1.0],
    "motor8_yaw"       : -9
}
