        </geometry>
        <material>
          <script>
            <name>Gazebo/White</name>
            <uri>__default__</uri>
          </script>
        </material>
        <plugin name="lumped_force_visual" filename="libgazebo_ForceVisual.so">
          <topic_name>lift_force/lumped_force</topic_name>
          <color>Gazebo/Red</color>
          <scale>10.0 10.0 10.0</scale>
        </plugin>
      </visual>
