<sdf version='1.5'>
  <model name='plane'>
    <pose>0 0 0 0 0 0</pose>
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>-0.105 0 -0.08 0 0 0</pose>
        <mass>10</mass>
        <inertia>
          <ixx>2.168</ixx>
          <ixy>0</ixy>
          <ixz>0.262</ixz>
          <iyy>1.242</iyy>
